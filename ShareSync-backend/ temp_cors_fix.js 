cat > temp_cors_fix.js << 'EOF'
// Find and replace CORS config in server.js
const fs = require('fs');
const serverPath = './server.js';
let content = fs.readFileSync(serverPath, 'utf8');

// Find the CORS section
const oldCors = `app.use(cors({
  origin: process.env.NODE_ENV === 'production' 
    ? process.env.FRONTEND_URL 
    : true, // Allow all origins in development
  credentials: true,
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS', 'PATCH'],
  allowedHeaders: ['Content-Type', 'Authorization', 'X-Requested-With']
}));`;

const newCors = `app.use(cors({
  origin: ['http://localhost:54693', 'http://localhost:5173', 'http://localhost:3000'],
  credentials: true,
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS', 'PATCH'],
  allowedHeaders: ['Content-Type', 'Authorization', 'X-Requested-With']
}));`;

content = content.replace(oldCors, newCors);
fs.writeFileSync(serverPath, content);
console.log('✅ CORS fixed!');
EOF

node temp_cors_fix.js
rm temp_cors_fix.js