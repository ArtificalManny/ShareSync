{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./src",
    "strictNullChecks": false,
    "noImplicitAny": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "typeRoots": ["node_modules/@types"],
    "types": ["node", "express", "multer"]
  },
  "include": ["src/**/*", "../ShareSync-frontend-backup/src/utils/usePrefersReducedMotion.js", "../ShareSync-frontend-backup/src/api/http.js", "../ShareSync-frontend-backup/src/api/stats.js"],
  "exclude": ["node_modules", "dist"]
}
