# ═══════════════════════════════════════════════════════════════════════════════
# SHARESYNC BACKEND ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=5050

# Database
MONGODB_URI=mongodb://localhost:27017/sharesync

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-too
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug

# Optional: Redis (for scaling)
# REDIS_URL=redis://localhost:6379

# Optional: S3 (for file storage)
# S3_BUCKET=sharesync-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# Optional: Email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# Optional: Monitoring
# SENTRY_DSN=your-sentry-dsn

# ═══════════════════════════════════════════════════════════════════════════════
# CONTENT MODERATION (Optional - services work without these)
# ═══════════════════════════════════════════════════════════════════════════════

# OpenAI API Key (for text moderation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AWS Credentials (for image moderation with Rekognition)
# Get from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ═══════════════════════════════════════════════════════════════════════════════
# STRIPE CONFIGURATION (Phase 5: Subscriptions)
# ═══════════════════════════════════════════════════════════════════════════════

# Stripe API Keys (from Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe Webhook Secret (from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (create in Stripe Dashboard > Products)
# Team Plan - $39/month
STRIPE_TEAM_MONTHLY_PRICE_ID=price_xxx
# Team Plan - $390/year (2 months free)
STRIPE_TEAM_YEARLY_PRICE_ID=price_xxx

# Enterprise Plan (optional - usually custom pricing)
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=

# Frontend URL for redirect
FRONTEND_URL=http://localhost:5173
