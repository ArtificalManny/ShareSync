# ═══════════════════════════════════════════════════════════════════════════════
# SHARESYNC BACKEND ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=5050

# Database
MONGODB_URI=mongodb://localhost:27017/sharesync

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-too
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug

# Optional: Redis (for scaling)
# REDIS_URL=redis://localhost:6379

# Optional: S3 (for file storage)
# S3_BUCKET=sharesync-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# Optional: Email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# Optional: Monitoring
# SENTRY_DSN=your-sentry-dsn
