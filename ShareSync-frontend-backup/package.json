{
  "name": "sharesync-frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lh:home": "lighthouse http://localhost:54693/home --only-categories=performance,accessibility,best-practices,seo --output html --output-path ./lhr-home.html",
    "lh:projects": "lighthouse http://localhost:54693/projects --only-categories=performance,accessibility,best-practices,seo --output html --output-path ./lhr-projects.html",
    "lh:projectId": "node -e \"const id=process.env.SS_PROJECT_ID||'REPLACE_ME'; if(id==='REPLACE_ME'){console.error('Set SS_PROJECT_ID'); process.exit(1)}; console.log('Running Lighthouse for', id)\" && lighthouse http://localhost:54693/projects/$SS_PROJECT_ID --only-categories=performance,accessibility,best-practices,seo --output html --output-path ./lhr-project.html",
    "lh:all": "npm run lh:home && npm run lh:projects && npm run lh:projectId"
  },
  "dependencies": {
    "@tsparticles/react": "^3.0.0",
    "axios": "^1.7.2",
    "canvas-confetti": "^1.9.3",
    "chart.js": "^4.4.3",
    "lucide-react": "^0.395.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.23.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^4.5.14"
  }
}
