{
  "name": "sharesync-frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "serve:dist": "vite preview --port 4173 --strictPort",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lh:prep": "npm run build && npm run serve:dist",
    "lh:home": "lighthouse http://localhost:4173/home --only-categories=performance,accessibility,best-practices,seo --output=json --output=html --output-path ./lighthouse/home_after --chrome-flags='--headless=new'",
    "lh:projects": "lighthouse http://localhost:4173/projects --only-categories=performance,accessibility,best-practices,seo --output=json --output=html --output-path ./lighthouse/projects_after --chrome-flags='--headless=new'",
    "lh:projectId": "node -e \"const id=process.env.SS_PROJECT_ID||'REPLACE_ME'; if(id==='REPLACE_ME'){console.error('Set SS_PROJECT_ID'); process.exit(1)}; console.log('Running Lighthouse for', id)\" && lighthouse http://localhost:4173/projects/$SS_PROJECT_ID --only-categories=performance,accessibility,best-practices,seo --output=json --output=html --output-path ./lighthouse/project_id_after --chrome-flags='--headless=new'",
    "lh:all": "node scripts/lh-run.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@nestjs/platform-socket.io": "^11.1.13",
    "@nestjs/websockets": "^11.1.13",
    "@react-spring/web": "^10.0.3",
    "@tanstack/react-query": "^5.90.20",
    "@tsparticles/react": "^3.0.0",
    "axios": "^1.13.4",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.4.3",
    "framer-motion": "^12.26.2",
    "html2canvas": "^1.4.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.395.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^6.23.1",
    "react-use": "^17.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.2.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.8.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^7.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^2.1.8"
  }
}
