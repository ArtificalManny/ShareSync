/* ═══════════════════════════════════════════════════════════════════════════
   Modern Utilities - DoorDash/Uber/Instagram Polish
   ═══════════════════════════════════════════════════════════════════════════ */

@layer components {
  /* ─────────────────────────────────────────────────────────────────────────
     Modern Glass Cards (replaces .glass-card with refined version)
  ───────────────────────────────────────────────────────────────────────── */
  .modern-card {
    @apply bg-white/90 dark:bg-slate-800/90;
    @apply backdrop-blur-md;
    @apply border border-slate-200/60 dark:border-slate-700/60;
    @apply rounded-2xl;
    @apply shadow-card;
    @apply transition-all duration-200;
  }
  
  .modern-card:hover {
    @apply shadow-lg;
    @apply border-slate-300/80 dark:border-slate-600/80;
  }
  
  /* Elevated card (for important content) */
  .modern-card-elevated {
    @apply modern-card;
    @apply shadow-pop;
  }
  
  /* ─────────────────────────────────────────────────────────────────────────
     Modern Buttons (crisp, minimal) + RIPPLE EFFECT
  ───────────────────────────────────────────────────────────────────────── */
  .btn-modern {
    @apply inline-flex items-center justify-center;
    @apply px-4 py-2.5;
    @apply rounded-xl;
    @apply font-semibold text-sm;
    @apply transition-all duration-150;
    @apply focus:outline-none focus:ring-4 focus:ring-primary-500/10;
    position: relative;
    overflow: hidden;
  }
  
  .btn-primary-modern {
    @apply btn-modern;
    @apply bg-primary-600 hover:bg-primary-700;
    @apply text-white;
    @apply shadow-sm hover:shadow-md;
    @apply active:scale-[0.98];
  }
  
  .btn-secondary-modern {
    @apply btn-modern;
    @apply bg-slate-100 hover:bg-slate-200;
    @apply dark:bg-slate-800 dark:hover:bg-slate-700;
    @apply text-slate-900 dark:text-slate-100;
  }
  
  .btn-ghost-modern {
    @apply btn-modern;
    @apply bg-transparent hover:bg-slate-100;
    @apply dark:hover:bg-slate-800;
    @apply text-slate-700 dark:text-slate-300;
  }

  /* ⭐ NEW: Button Ripple Effect */
  .btn-modern::after,
  .btn-primary-modern::after,
  .btn-secondary-modern::after,
  .btn-ghost-modern::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s ease-out, height 0.6s ease-out, opacity 0.6s ease-out;
    opacity: 0;
  }

  .btn-modern:active::after,
  .btn-primary-modern:active::after,
  .btn-secondary-modern:active::after,
  .btn-ghost-modern:active::after {
    width: 300px;
    height: 300px;
    opacity: 1;
    transition: width 0s, height 0s, opacity 0s;
  }

  /* ⭐ NEW: Loading State */
  .btn-loading {
    pointer-events: none;
    opacity: 0.7;
    position: relative;
  }

  .btn-loading::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    animation: shimmer 1.5s infinite;
  }
  
  /* ─────────────────────────────────────────────────────────────────────────
     Modern Inputs (Instagram-style)
  ───────────────────────────────────────────────────────────────────────── */
  .input-modern {
    @apply w-full px-4 py-3;
    @apply bg-slate-50 dark:bg-slate-900/50;
    @apply border border-slate-200 dark:border-slate-700;
    @apply rounded-xl;
    @apply text-sm text-slate-900 dark:text-slate-100;
    @apply placeholder:text-slate-400;
    @apply transition-all duration-200;
    @apply focus:outline-none focus:ring-4 focus:ring-primary-500/10 focus:border-primary-500;
  }
  
  /* ─────────────────────────────────────────────────────────────────────────
     Modern Badges (Uber-style)
  ───────────────────────────────────────────────────────────────────────── */
  .badge-modern {
    @apply inline-flex items-center gap-1;
    @apply px-2.5 py-1;
    @apply rounded-lg;
    @apply text-xs font-medium;
    @apply border;
  }
  
  .badge-success {
    @apply badge-modern;
    @apply bg-emerald-50 dark:bg-emerald-500/10;
    @apply border-emerald-200 dark:border-emerald-500/20;
    @apply text-emerald-700 dark:text-emerald-400;
  }
  
  .badge-warning {
    @apply badge-modern;
    @apply bg-amber-50 dark:bg-amber-500/10;
    @apply border-amber-200 dark:border-amber-500/20;
    @apply text-amber-700 dark:text-amber-400;
  }
  
  .badge-info {
    @apply badge-modern;
    @apply bg-blue-50 dark:bg-blue-500/10;
    @apply border-blue-200 dark:border-blue-500/20;
    @apply text-blue-700 dark:text-blue-400;
  }
  
  /* ─────────────────────────────────────────────────────────────────────────
     Modern Stat Cards (DoorDash-style)
  ───────────────────────────────────────────────────────────────────────── */
  .stat-card-modern {
    @apply modern-card;
    @apply p-5;
    @apply space-y-2;
  }
  
  .stat-label {
    @apply text-xs font-medium text-slate-500 dark:text-slate-400;
    @apply uppercase tracking-wide;
  }
  
  .stat-value {
    @apply text-2xl font-bold text-slate-900 dark:text-slate-100;
    @apply tracking-tight;
  }
  
  .stat-change {
    @apply inline-flex items-center gap-1;
    @apply text-sm font-medium;
  }
  
  .stat-change-positive {
    @apply stat-change text-emerald-600 dark:text-emerald-400;
  }
  
  .stat-change-negative {
    @apply stat-change text-red-600 dark:text-red-400;
  }
  
  /* ─────────────────────────────────────────────────────────────────────────
     Modern Typography
  ───────────────────────────────────────────────────────────────────────── */
  .heading-1 {
    @apply text-4xl font-bold tracking-tight;
    @apply text-slate-900 dark:text-white;
  }
  
  .heading-2 {
    @apply text-3xl font-bold tracking-tight;
    @apply text-slate-900 dark:text-white;
  }
  
  .heading-3 {
    @apply text-xl font-semibold;
    @apply text-slate-900 dark:text-white;
  }
  
  .body-text {
    @apply text-base text-slate-700 dark:text-slate-300;
    @apply leading-relaxed;
  }
  
  .caption-text {
    @apply text-sm text-slate-500 dark:text-slate-400;
  }
  
  /* ─────────────────────────────────────────────────────────────────────────
     Loading States (Skeleton)
  ───────────────────────────────────────────────────────────────────────── */
  .skeleton {
    @apply bg-slate-200 dark:bg-slate-700;
    @apply rounded-lg;
    @apply animate-pulse;
  }
  
  .skeleton-text {
    @apply skeleton h-4 w-full;
  }
  
  .skeleton-avatar {
    @apply skeleton h-12 w-12 rounded-full;
  }
  
  /* ─────────────────────────────────────────────────────────────────────────
     Dividers (Minimal)
  ───────────────────────────────────────────────────────────────────────── */
  .divider-modern {
    @apply border-t border-slate-200 dark:border-slate-700;
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
   Animations (outside @layer to avoid conflicts)
   ═══════════════════════════════════════════════════════════════════════════ */

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ═══════════════════════════════════════════════════════════════════════════
   ⭐ NEW: Stagger Animations
   ═══════════════════════════════════════════════════════════════════════════ */

.stagger-item {
  animation: slideUp 0.3s ease-out backwards;
}

/* Apply stagger delays via inline styles: style={{ animationDelay: `${idx * 50}ms` }} */

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Fade in animation */
.fade-in {
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* Scale in animation */
.scale-in {
  animation: scaleIn 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}
