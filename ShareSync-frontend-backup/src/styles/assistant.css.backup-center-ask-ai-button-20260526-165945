/* src/styles/assistant.css */
/* ═══════════════════════════════════════════════════════════════════════════════
   DESIGN SYSTEM v2.0 - PHASE 5: Quiet Confidence
   ═══════════════════════════════════════════════════════════════════════════════
   FIXED: Removed resting glows (box-shadow with colored rgba)
   FIXED: Removed gradients → Solid semantic colors
   FIXED: Removed neon effects → Clean, professional styling
   ═══════════════════════════════════════════════════════════════════════════════ */

/* ─────────────────────────────────────────────────────────────────────────
   CHIP
───────────────────────────────────────────────────────────────────────── */
.askai-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.3rem 0.6rem;
  border-radius: 999px;
  border: 1px solid var(--border, rgba(255,255,255,0.06));
  background: var(--surface-1, rgba(255,255,255,0.04));
  font-size: 12px;
  line-height: 1;
  transition: background 0.2s ease;
}
.askai-chip:hover { 
  background: var(--surface-2, rgba(255,255,255,0.08)); 
}
.askai-chip:focus-visible { 
  outline: 2px solid var(--brand, #8b5cf6); 
  outline-offset: 2px; 
}

/* ─────────────────────────────────────────────────────────────────────────
   BUTTON
───────────────────────────────────────────────────────────────────────── */
.askai-button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.45rem 0.7rem;
  border-radius: 10px;
  border: 1px solid var(--border, rgba(255,255,255,0.06));
  background: var(--surface-1, rgba(255,255,255,0.04));
  font-size: 13px;
  transition: background 0.2s ease;
}
.askai-button:hover { 
  background: var(--surface-2, rgba(255,255,255,0.08)); 
}
.askai-button:focus-visible { 
  outline: 2px solid var(--brand, #6366f1); 
  outline-offset: 2px; 
}

/* ─────────────────────────────────────────────────────────────────────────
   ICON
───────────────────────────────────────────────────────────────────────── */
.askai-icon {
  display: inline-grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  border: 1px solid var(--border, rgba(255,255,255,0.06));
  background: var(--surface-1, rgba(255,255,255,0.04));
  transition: background 0.2s ease;
}
.askai-icon:hover {
  background: var(--surface-2, rgba(255,255,255,0.08));
}
.askai-icon:focus-visible { 
  outline: 2px solid var(--brand, #8b5cf6); 
  outline-offset: 2px; 
}

/* ─────────────────────────────────────────────────────────────────────────
   BACKDROP
───────────────────────────────────────────────────────────────────────── */
.assistant-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.5);
}

/* ─────────────────────────────────────────────────────────────────────────
   DOCK
───────────────────────────────────────────────────────────────────────── */
.assistant-dock {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 18px;
  z-index: 81;
  width: min(920px, 96vw);
  border-radius: 16px;
  border: 1px solid var(--border, rgba(255,255,255,0.06));
  background: var(--surface-1, rgba(15,23,42,0.95));
  backdrop-filter: blur(12px);
  color: var(--text-primary, #f8fafc);
}

/* ─────────────────────────────────────────────────────────────────────────
   HEADER
───────────────────────────────────────────────────────────────────────── */
.assistant-dock__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  border-bottom: 1px solid var(--border, rgba(255,255,255,0.06));
}

.assistant-title { 
  font-weight: 600; 
  font-size: 13px; 
  display: inline-flex; 
  align-items: center; 
  gap: 8px; 
}

/* Status dot - quiet, no glow */
.assistant-dot { 
  width: 6px; 
  height: 6px; 
  border-radius: 999px; 
  background: var(--brand, #8b5cf6);
}

.assistant-iconbtn { 
  padding: 6px; 
  border-radius: 8px;
  transition: background 0.2s ease;
}
.assistant-iconbtn:hover { 
  background: var(--surface-2, rgba(255,255,255,0.08)); 
}

/* ─────────────────────────────────────────────────────────────────────────
   ROWS
───────────────────────────────────────────────────────────────────────── */
.assistant-dock__row { 
  padding: 10px 12px; 
}

.assistant-suggestions { 
  display: flex; 
  flex-wrap: wrap; 
  gap: 6px; 
}

.assistant-suggestion {
  font-size: 12px;
  padding: 0.25rem 0.5rem;
  border-radius: 999px;
  border: 1px dashed var(--border, rgba(255,255,255,0.1));
  background: var(--surface-0, rgba(255,255,255,0.02));
  transition: all 0.2s ease;
}
.assistant-suggestion:hover { 
  border-style: solid;
  background: var(--surface-1, rgba(255,255,255,0.04));
}

.assistant-label { 
  display: block; 
  font-size: 11px; 
  color: var(--text-tertiary, #64748b); 
  margin-bottom: 6px; 
}

/* ─────────────────────────────────────────────────────────────────────────
   INPUT
───────────────────────────────────────────────────────────────────────── */
.assistant-input {
  width: 100%;
  border-radius: 12px;
  border: 1px solid var(--border, rgba(255,255,255,0.06));
  background: var(--surface-0, rgba(255,255,255,0.02));
  padding: 10px 12px;
  font-size: 13px;
  min-height: 76px;
  color: var(--text-primary, #f8fafc);
  transition: border-color 0.2s ease;
}
.assistant-input::placeholder {
  color: var(--text-tertiary, #64748b);
}
.assistant-input:focus-visible {
  outline: none;
  border-color: var(--brand, #8b5cf6);
}

/* ─────────────────────────────────────────────────────────────────────────
   ACTIONS
───────────────────────────────────────────────────────────────────────── */
.assistant-actions { 
  display: flex; 
  justify-content: flex-end; 
  margin-top: 8px; 
}

.assistant-run {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 10px;
  color: white;
  background: var(--brand, #8b5cf6);
  border: none;
  font-weight: 500;
  transition: opacity 0.2s ease;
}
.assistant-run:hover {
  opacity: 0.9;
}
.assistant-run:disabled { 
  opacity: 0.5; 
  cursor: not-allowed; 
}

/* ─────────────────────────────────────────────────────────────────────────
   OUTPUT
───────────────────────────────────────────────────────────────────────── */
.assistant-output {
  border-radius: 12px;
  border: 1px dashed var(--border, rgba(255,255,255,0.1));
  background: var(--surface-0, rgba(255,255,255,0.02));
  min-height: 96px;
  padding: 10px 12px;
}
.assistant-output[data-empty="true"] { 
  display: grid; 
  place-items: center; 
  color: var(--text-tertiary, #64748b); 
}

.assistant-pre { 
  white-space: pre-wrap; 
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial; 
  font-size: 13px; 
}

.assistant-output-actions { 
  display: flex; 
  gap: 8px; 
  margin-top: 8px; 
}

.assistant-ghost {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 10px;
  border: 1px solid var(--border, rgba(255,255,255,0.06));
  background: var(--surface-0, rgba(255,255,255,0.02));
  font-size: 12px;
  transition: background 0.2s ease;
}
.assistant-ghost:hover { 
  background: var(--surface-1, rgba(255,255,255,0.04)); 
}
