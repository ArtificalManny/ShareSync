export default function CompleteProjectModal({
  isOpen,
  onClose,
  onSubmit,
  finishLine,
  projectName = "Project",
  isSubmitting = false,
  allowForceComplete = true,
}) {
  const [step, setStep] = useState(0);
  const [outcomeStatus, setOutcomeStatus] = useState("achieved");
  const [leftoverDecision, setLeftoverDecision] = useState("backlog");
  const [closureSummary, setClosureSummary] = useState("");
  const [followUpProjectId, setFollowUpProjectId] = useState("");
  const [forceComplete, setForceComplete] = useState(false);
  const [closureChecklist, setClosureChecklist] = useState(DEFAULT_CHECKLIST);

  const blockers = useMemo(
    () => uniqueStrings(finishLine?.blockingReasons || []),
    [finishLine]
  );

  const warnings = useMemo(
    () => uniqueStrings(finishLine?.warnings || []),
    [finishLine]
  );

  const readinessScore = safeNumber(finishLine?.readinessScore, 0);
  const openTaskCount = safeNumber(finishLine?.openTaskCount, 0);
  const criticalOpenCount = safeNumber(finishLine?.openCriticalTaskCount, 0);
  const blockedTaskCount = safeNumber(finishLine?.blockedTaskCount, 0);
  const activeGoalCount = safeNumber(finishLine?.activeGoalCount, 0);
  const completedGoalCount = safeNumber(finishLine?.completedGoalCount, 0);
  const isReadyToClose = Boolean(finishLine?.isReadyToClose);
  const isCompleted = Boolean(finishLine?.isCompleted);

  const isSummaryValid = closureSummary.trim().length >= 20;
  const scoreGap = Math.max(0, 100 - readinessScore);

  const scoreNarrative = useMemo(() => {
    if (isCompleted) {
      return "This project is already historical. The closeout flow is now a record of how it ended.";
    }

    if (readinessScore >= 100) {
      return "Nothing is currently withholding a perfect closeout score.";
    }

    if (isReadyToClose && warnings.length > 0) {
      return `${scoreGap} points are still withheld by closeout proof signals, not execution risk.`;
    }

    if (blockers.length > 0) {
      return `${scoreGap} points are being held back by unfinished execution risk and closure friction.`;
    }

    if (warnings.length > 0) {
      return `${scoreGap} points are being held back by unresolved closeout signals.`;
    }

    return `${scoreGap} points still separate this project from a perfect finish-line score.`;
  }, [isCompleted, readinessScore, isReadyToClose, warnings.length, blockers.length, scoreGap]);

  const decisionPreview = useMemo(() => {
    const base = {
      title: "No leftover decision selected yet",
      description: "Choose how OpenShare should handle unfinished work before the project is closed.",
      tone: "slate",
    };

    if (!leftoverDecision) return base;

    if (leftoverDecision === "backlog") {
      return {
        title: `Send ${pluralize(openTaskCount, "open task")} back to backlog`,
        description:
          openTaskCount > 0
            ? "This preserves unfinished work without letting it block the historical definition of done."
            : "There is no open work right now, so this decision acts as a safety default.",
        tone: "violet",
      };
    }

    if (leftoverDecision === "defer") {
      return {
        title: `Defer ${pluralize(openTaskCount, "open task")} into a later phase`,
        description:
          "This tells the team the work still matters, but it no longer belongs in the finish criteria of this project.",
        tone: "amber",
      };
    }

    if (leftoverDecision === "cancel") {
      return {
        title: `Mark ${pluralize(openTaskCount, "open task")} as intentionally dropped`,
        description:
          "This creates a hard historical line: the project is complete, and the unfinished work is no longer part of the mission.",
        tone: "rose",
      };
    }

    if (leftoverDecision === "follow_up") {
      return {
        title: `Push ${pluralize(openTaskCount, "open task")} into a follow-up mission`,
        description:
          followUpProjectId.trim().length > 0
            ? `The follow-up project will become the new container for the unfinished work (${followUpProjectId.trim()}).`
            : "Provide a follow-up project ID to preserve continuity without contaminating this closeout.",
        tone: "teal",
      };
    }

    return base;
  }, [leftoverDecision, openTaskCount, followUpProjectId]);

  const summaryPrompts = useMemo(() => {
    const prompts = [
      "What did this project actually deliver?",
      "What remains unfinished, deferred, or intentionally dropped?",
      "Why is it still valid to call this project complete now?",
    ];

    if (outcomeStatus === "partially_achieved") {
      prompts.push("What value was delivered even though the full ambition was not reached?");
    }

    if (outcomeStatus === "canceled") {
      prompts.push("Why was closing the project the right decision?");
    }

    if (leftoverDecision === "follow_up") {
      prompts.push("What work is being handed into the follow-up project?");
    }

    if (blockedTaskCount > 0 || criticalOpenCount > 0) {
      prompts.push("How were the remaining risks acknowledged or contained at closeout?");
    }

    return prompts;
  }, [outcomeStatus, leftoverDecision, blockedTaskCount, criticalOpenCount]);

  useEffect(() => {
    if (!isOpen) return;

    setStep(0);
    setOutcomeStatus(finishLine?.outcomeStatus || "achieved");
    setLeftoverDecision("backlog");
    setClosureSummary(finishLine?.closureSummary || "");
    setFollowUpProjectId("");
    setForceComplete(false);
    setClosureChecklist({
      primaryGoalConfirmed: false,
      openWorkResolved: isReadyToClose,
      blockersReviewed: false,
      handoffPrepared: false,
      stakeholderSignoff: false,
    });
  }, [isOpen, finishLine?.outcomeStatus, finishLine?.closureSummary, isReadyToClose]);

  useEffect(() => {
    if (!isOpen) return;

    const handleEscape = (event) => {
      if (event.key === "Escape" && !isSubmitting) {
        onClose?.();
      }
    };

    window.addEventListener("keydown", handleEscape);
    return () => window.removeEventListener("keydown", handleEscape);
  }, [isOpen, isSubmitting, onClose]);

  useEffect(() => {
    setClosureChecklist((prev) => ({
      ...prev,
      summaryWritten: isSummaryValid,
    }));
  }, [isSummaryValid]);

  if (!isOpen) return null;

  const canMoveFromReadiness =
    blockers.length === 0 || (allowForceComplete && forceComplete);

  const canMoveFromOutcome = Boolean(outcomeStatus);

  const canMoveFromLeftovers =
    leftoverDecision !== "follow_up" || followUpProjectId.trim().length > 0;

  const canSubmit =
    canMoveFromReadiness &&
    canMoveFromOutcome &&
    canMoveFromLeftovers &&
    isSummaryValid &&
    closureChecklist.primaryGoalConfirmed &&
    closureChecklist.blockersReviewed &&
    closureChecklist.stakeholderSignoff;

  const nextDisabled =
    (step === 0 && !canMoveFromReadiness) ||
    (step === 1 && !canMoveFromOutcome) ||
    (step === 2 && !canMoveFromLeftovers);

  const handleChecklist = (key, value) => {
    setClosureChecklist((prev) => ({
      ...prev,
      [key]: value,
    }));
  };

  const handleSubmit = async () => {
    if (!canSubmit || isSubmitting) return;

    const payload = {
      closureSummary: closureSummary.trim(),
      outcomeStatus,
      leftoverDecision,
      followUpProjectId:
        leftoverDecision === "follow_up" ? followUpProjectId.trim() : undefined,
      forceComplete,
      closureChecklist: {
        ...closureChecklist,
        summaryWritten: true,
      },
    };

    await onSubmit?.(payload);
  };

  const heroTone = isCompleted
    ? "from-emerald-50 via-white to-teal-50 dark:from-emerald-500/10 dark:via-emerald-500/[0.03] dark:to-teal-500/[0.06]"
    : isReadyToClose
      ? "from-teal-50 via-white to-cyan-50 dark:from-teal-500/10 dark:via-teal-500/[0.03] dark:to-cyan-500/[0.06]"
      : "from-violet-50 via-white to-fuchsia-50/70 dark:from-violet-500/10 dark:via-violet-500/[0.03] dark:to-fuchsia-500/[0.06]";

  return (
    <div className="fixed inset-0 z-[200]">
      <div
        className="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"
        onClick={() => !isSubmitting && onClose?.()}
      />

      <div className="absolute inset-0 overflow-y-auto">
        <div className="min-h-full flex items-center justify-center px-4 py-8">
          <div className="relative w-full max-w-6xl rounded-[32px] border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-[#0f1115] shadow-2xl overflow-hidden">
            <div
              className={cn(
                "px-6 md:px-8 py-6 border-b border-slate-200/80 dark:border-white/[0.06]",
                "bg-gradient-to-br",
                heroTone
              )}
            >
              <div className="flex items-start justify-between gap-4 mb-5">
                <div className="min-w-0">
                  <div className="text-[11px] uppercase tracking-wider font-semibold text-slate-500 dark:text-zinc-500 mb-1">
                    Guided Closeout
                  </div>
                  <h2 className="text-2xl md:text-[28px] font-semibold text-slate-900 dark:text-zinc-100">
                    Complete {projectName}
                  </h2>
                  <p className="mt-2 text-sm md:text-[15px] leading-relaxed text-slate-600 dark:text-zinc-300 max-w-3xl">
                    Turn completion into a clean, intentional ritual. Review readiness,
                    choose how to handle leftovers, write the closeout story, and then
                    formally declare the mission finished.
                  </p>
                </div>

                <button
                  type="button"
                  onClick={() => !isSubmitting && onClose?.()}
                  className="w-11 h-11 rounded-2xl border border-slate-200 dark:border-white/[0.08] bg-white/80 dark:bg-white/[0.03] text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors flex items-center justify-center"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>

              <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
                <MetricTile
                  icon={Flag}
                  label="Readiness"
                  value={`${readinessScore}%`}
                  tone={isReadyToClose ? "teal" : "neutral"}
                />
                <MetricTile
                  icon={Layers3}
                  label="Open tasks"
                  value={openTaskCount}
                  tone="neutral"
                />
                <MetricTile
                  icon={AlertTriangle}
                  label="Critical open"
                  value={criticalOpenCount}
                  tone={criticalOpenCount > 0 ? "amber" : "neutral"}
                />
                <MetricTile
                  icon={Sparkles}
                  label="Blockers"
                  value={blockedTaskCount}
                  tone={blockedTaskCount > 0 ? "rose" : "neutral"}
                />
                <MetricTile
                  icon={Target}
                  label="Goals"
                  value={`${completedGoalCount}/${completedGoalCount + activeGoalCount}`}
                  tone="emerald"
                />
              </div>
            </div>

            <div className="px-6 md:px-8 py-5 border-b border-slate-200/80 dark:border-white/[0.06] bg-slate-50/60 dark:bg-white/[0.015]">
              <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                {STEPS.map((label, index) => (
                  <StepBadge
                    key={label}
                    index={index}
                    label={label}
                    currentStep={step}
                  />
                ))}
              </div>
            </div>

            <div className="px-6 md:px-8 py-6 md:py-7 max-h-[70vh] overflow-y-auto">
              {step === 0 ? (
                <div>
                  <SectionTitle
                    icon={Gauge}
                    eyebrow="Step 1"
                    title="Review closure readiness"
                    description="Before finishing the project, make the blockers explicit. This is where trust in the finish line is created."
                    tone={isReadyToClose ? "teal" : "amber"}
                  />

                  <div className="grid grid-cols-1 xl:grid-cols-[1.05fr_0.95fr] gap-5">
                    <div className="space-y-4">
                      <div className="rounded-[26px] border border-slate-200 dark:border-white/[0.06] bg-slate-50/70 dark:bg-white/[0.02] p-5">
                        <div className="flex items-center gap-2 mb-3">
                          <AlertTriangle className="w-4 h-4 text-amber-500" />
                          <h4 className="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-zinc-500">
                            Blocking reasons
                          </h4>
                        </div>

                        {blockers.length > 0 ? (
                          <ul className="space-y-2.5">
                            {blockers.map((item, index) => (
                              <li
                                key={`blocker-${index}`}
                                className="rounded-2xl border border-slate-200 dark:border-white/[0.06] bg-white dark:bg-white/[0.02] px-4 py-3 text-sm leading-relaxed text-slate-700 dark:text-zinc-200"
                              >
                                {item}
                              </li>
                            ))}
                          </ul>
                        ) : (
                          <div className="rounded-2xl border border-emerald-200 dark:border-emerald-500/20 bg-emerald-50/80 dark:bg-emerald-500/8 px-4 py-4 text-sm text-emerald-700 dark:text-emerald-300">
                            No hard blockers remain. The project is structurally capable of clean closeout.
                          </div>
                        )}
                      </div>

                      {warnings.length > 0 ? (
                        <div className="rounded-[26px] border border-slate-200 dark:border-white/[0.06] bg-slate-50/70 dark:bg-white/[0.02] p-5">
                          <div className="flex items-center gap-2 mb-3">
                            <ShieldCheck className="w-4 h-4 text-violet-500" />
                            <h4 className="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-zinc-500">
                              Warnings
                            </h4>
                          </div>

                          <ul className="space-y-2">
                            {warnings.map((item, index) => (
                              <li
                                key={`warning-${index}`}
                                className="text-sm leading-relaxed text-slate-600 dark:text-zinc-300"
                              >
                                {item}
                              </li>
                            ))}
                          </ul>
                        </div>
                      ) : null}
                    </div>

                    <div className="rounded-[26px] border border-slate-200 dark:border-white/[0.06] bg-white dark:bg-white/[0.02] p-5">
                      <div className="flex items-center gap-2 mb-3">
                        <ClipboardCheck className="w-4 h-4 text-teal-500" />
                        <h4 className="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-zinc-500">
                          Closeout checklist
                        </h4>
                      </div>

                      <div className="space-y-3">
                        <ChecklistItem
                          checked={closureChecklist.primaryGoalConfirmed}
                          onChange={(value) =>
                            handleChecklist("primaryGoalConfirmed", value)
                          }
                          label="Primary goal confirmed"
                          description="The main objective of this project has been honestly evaluated."
                        />

                        <ChecklistItem
                          checked={closureChecklist.openWorkResolved}
                          onChange={(value) =>
                            handleChecklist("openWorkResolved", value)
                          }
                          label="Open work intentionally resolved"
                          description="The remaining open work has a deliberate plan instead of being ignored."
                        />

                        <ChecklistItem
                          checked={closureChecklist.blockersReviewed}
                          onChange={(value) =>
                            handleChecklist("blockersReviewed", value)
                          }
                          label="Blockers reviewed"
                          description="Every blocker has been resolved, accepted, or consciously handed off."
                        />

                        <ChecklistItem
                          checked={closureChecklist.handoffPrepared}
                          onChange={(value) =>
                            handleChecklist("handoffPrepared", value)
                          }
                          label="Handoff prepared"
                          description="Stakeholders or future owners can understand what was done and what remains."
                        />

                        <ChecklistItem
                          checked={closureChecklist.stakeholderSignoff}
                          onChange={(value) =>
                            handleChecklist("stakeholderSignoff", value)
                          }
                          label="Stakeholder signoff recorded"
                          description="The finish line is acknowledged, not just clicked."
                        />
                      </div>

                      {!isReadyToClose && allowForceComplete ? (
                        <div className="mt-5 rounded-2xl border border-amber-200 dark:border-amber-500/20 bg-amber-50/80 dark:bg-amber-500/8 px-4 py-4">
                          <label className="flex items-start gap-3 cursor-pointer">
                            <input
                              type="checkbox"
                              checked={forceComplete}
                              onChange={(e) => setForceComplete(e.target.checked)}
                              className="mt-1 h-4 w-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500"
                            />
                            <div>
                              <div className="text-sm font-medium text-amber-800 dark:text-amber-300">
                                Force close anyway
                              </div>
                              <div className="mt-1 text-xs leading-relaxed text-amber-700 dark:text-amber-200">
                                Use only when you intentionally want to end the project despite unresolved blockers.
                              </div>
                            </div>
                          </label>
                        </div>
                      ) : null}
                    </div>
                  </div>
                </div>
              ) : null}

              {step === 1 ? (
                <div>
                  <SectionTitle
                    icon={Target}
                    eyebrow="Step 2"
                    title="Declare the final outcome"
                    description="Completion should explain reality, not hide it. Pick the outcome that best matches what the team actually achieved."
                    tone="teal"
                  />

                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                    {OUTCOME_OPTIONS.map((option) => (
                      <SelectCard
                        key={option.value}
                        selected={outcomeStatus === option.value}
                        onClick={() => setOutcomeStatus(option.value)}
                        icon={option.icon}
                        title={option.title}
                        description={option.description}
                        tone={option.tone}
                      />
                    ))}
                  </div>

                  <div className="mt-5 rounded-[26px] border border-slate-200 dark:border-white/[0.06] bg-slate-50/70 dark:bg-white/[0.02] p-5">
                    <div className="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-zinc-500 mb-3">
                      What this does psychologically
                    </div>
                    <p className="text-sm leading-relaxed text-slate-600 dark:text-zinc-300">
                      This makes the finish line trustworthy. Teams stop lying to themselves,
                      leaders trust the dashboard more, and OpenShare becomes the system that
                      tells the truth about whether work really crossed the line.
                    </p>
                  </div>
                </div>
              ) : null}

              {step === 2 ? (
                <div>
                  <SectionTitle
                    icon={Archive}
                    eyebrow="Step 3"
                    title="Choose how to handle leftovers"
                    description="Most projects never close because of loose ends. This step turns ambiguity into an explicit decision."
                    tone="amber"
                  />

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {LEFTOVER_OPTIONS.map((option) => (
                      <SelectCard
                        key={option.value}
                        selected={leftoverDecision === option.value}
                        onClick={() => setLeftoverDecision(option.value)}
                        icon={option.icon}
                        title={option.title}
                        description={option.description}
                        tone={option.tone}
                      />
                    ))}
                  </div>

                  {leftoverDecision === "follow_up" ? (
                    <div className="mt-5 rounded-[26px] border border-teal-200 dark:border-teal-500/20 bg-teal-50/80 dark:bg-teal-500/8 p-5">
                      <label className="block">
                        <div className="text-sm font-medium text-slate-900 dark:text-zinc-100 mb-2">
                          Follow-up project ID
                        </div>
                        <input
                          type="text"
                          value={followUpProjectId}
                          onChange={(e) => setFollowUpProjectId(e.target.value)}
                          placeholder="Paste the follow-up project ID"
                          className="w-full rounded-2xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.03] px-4 py-3 text-sm text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 outline-none focus:ring-2 focus:ring-teal-500/30"
                        />
                      </label>
                      <p className="mt-2 text-xs leading-relaxed text-slate-600 dark:text-zinc-300">
                        This keeps this project’s finish line clean while preserving continuity for remaining work.
                      </p>
                    </div>
                  ) : null}

                  <div className="mt-5 rounded-[26px] border border-slate-200 dark:border-white/[0.06] bg-slate-50/70 dark:bg-white/[0.02] p-5">
                    <div className="flex items-center gap-2 mb-3">
                      <Layers3 className="w-4 h-4 text-violet-500" />
                      <h4 className="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-zinc-500">
                        Decision impact preview
                      </h4>
                    </div>

                    <div className="rounded-2xl border border-slate-200 dark:border-white/[0.06] bg-white dark:bg-white/[0.02] px-4 py-4 mb-4">
                      <div className="text-sm font-semibold text-slate-900 dark:text-zinc-100 mb-1">
                        {decisionPreview.title}
                      </div>
                      <p className="text-sm leading-relaxed text-slate-600 dark:text-zinc-300">
                        {decisionPreview.description}
                      </p>
                    </div>

                    <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                      <MetricTile
                        icon={Layers3}
                        label="Open tasks"
                        value={openTaskCount}
                        tone="neutral"
                      />
                      <MetricTile
                        icon={AlertTriangle}
                        label="Critical open"
                        value={criticalOpenCount}
                        tone={criticalOpenCount > 0 ? "amber" : "neutral"}
                      />
                      <MetricTile
                        icon={Sparkles}
                        label="Blockers"
                        value={blockedTaskCount}
                        tone={blockedTaskCount > 0 ? "rose" : "neutral"}
                      />
                      <MetricTile
                        icon={Target}
                        label="Active goals"
                        value={activeGoalCount}
                        tone={activeGoalCount > 0 ? "amber" : "neutral"}
                      />
                    </div>
                  </div>
                </div>
              ) : null}

              {step === 3 ? (
                <div>
                  <SectionTitle
                    icon={FileText}
                    eyebrow="Step 4"
                    title="Write the closeout story"
                    description="This is the permanent explanation of what happened, what was achieved, and how the project ended."
                    tone="emerald"
                  />

                  <div className="grid grid-cols-1 xl:grid-cols-[1.05fr_0.95fr] gap-5">
                    <div className="rounded-[26px] border border-slate-200 dark:border-white/[0.06] bg-white dark:bg-white/[0.02] p-5">
                      <div className="mb-4 rounded-[22px] border border-violet-200 dark:border-violet-500/20 bg-violet-50/80 dark:bg-violet-500/8 p-4">
                        <div className="flex items-center gap-2 mb-2">
                          <FileText className="w-4 h-4 text-violet-600 dark:text-violet-300" />
                          <div className="text-xs font-semibold uppercase tracking-wider text-violet-700 dark:text-violet-300">
                            A strong closeout summary covers
                          </div>
                        </div>

                        <ul className="space-y-2">
                          {summaryPrompts.map((prompt) => (
                            <li
                              key={prompt}
                              className="text-sm leading-relaxed text-slate-700 dark:text-zinc-200"
                            >
                              • {prompt}
                            </li>
                          ))}
                        </ul>
                      </div>

                      <label className="block">
                        <div className="text-sm font-medium text-slate-900 dark:text-zinc-100 mb-2">
                          Closure summary
                        </div>
                        <textarea
                          value={closureSummary}
                          onChange={(e) => setClosureSummary(e.target.value)}
                          rows={10}
                          placeholder="Describe what was delivered, what was intentionally left behind, what the final outcome was, and why this project can now be considered complete."
                          className="w-full rounded-[22px] border border-slate-200 dark:border-white/[0.08] bg-slate-50/70 dark:bg-white/[0.03] px-4 py-4 text-sm leading-relaxed text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 outline-none focus:ring-2 focus:ring-violet-500/30 resize-none"
                        />
                      </label>

                      <div className="mt-3 flex items-center justify-between text-xs">
                        <span
                          className={cn(
                            "font-medium",
                            isSummaryValid
                              ? "text-emerald-600 dark:text-emerald-300"
                              : "text-amber-600 dark:text-amber-300"
                          )}
                        >
                          {isSummaryValid
                            ? "Summary is strong enough for closeout."
                            : "Write at least 20 characters so the finish line has real narrative weight."}
                        </span>
                        <span className="text-slate-500 dark:text-zinc-400">
                          {closureSummary.trim().length} chars
                        </span>
                      </div>
                    </div>

                    <div className="space-y-4">
                      <div className="rounded-[26px] border border-slate-200 dark:border-white/[0.06] bg-slate-50/70 dark:bg-white/[0.02] p-5">
                        <div className="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-zinc-500 mb-3">
                          Final payload preview
                        </div>

                        <div className="space-y-3 text-sm text-slate-700 dark:text-zinc-200">
                          <div className="flex items-start justify-between gap-4">
                            <span className="text-slate-500 dark:text-zinc-400">Outcome</span>
                            <span className="font-medium">{formatLabel(outcomeStatus)}</span>
                          </div>

                          <div className="flex items-start justify-between gap-4">
                            <span className="text-slate-500 dark:text-zinc-400">Leftovers</span>
                            <span className="font-medium">{formatLabel(leftoverDecision)}</span>
                          </div>

                          <div className="flex items-start justify-between gap-4">
                            <span className="text-slate-500 dark:text-zinc-400">Force close</span>
                            <span className="font-medium">{forceComplete ? "Yes" : "No"}</span>
                          </div>

                          <div className="flex items-start justify-between gap-4">
                            <span className="text-slate-500 dark:text-zinc-400">Signoff</span>
                            <span className="font-medium">
                              {closureChecklist.stakeholderSignoff ? "Confirmed" : "Missing"}
                            </span>
                          </div>
                        </div>
                      </div>

                      <div className="rounded-[26px] border border-emerald-200 dark:border-emerald-500/20 bg-emerald-50/80 dark:bg-emerald-500/8 p-5">
                        <div className="flex items-center gap-2 mb-3">
                          <Rocket className="w-4 h-4 text-emerald-600 dark:text-emerald-300" />
                          <div className="text-xs font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">
                            Why this matters
                          </div>
                        </div>

                        <p className="text-sm leading-relaxed text-emerald-800 dark:text-emerald-200">
                          This is what makes OpenShare feel more serious than a task tracker.
                          It does not just monitor work. It helps teams land work.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              ) : null}
            </div>

            <div className="px-6 md:px-8 py-5 border-t border-slate-200/80 dark:border-white/[0.06] bg-slate-50/60 dark:bg-white/[0.015]">
              <div className="flex flex-col-reverse md:flex-row md:items-center md:justify-between gap-3">
                <div className="flex items-center gap-2">
                  <button
                    type="button"
                    onClick={() => {
                      if (step === 0) {
                        onClose?.();
                        return;
                      }
                      setStep((prev) => Math.max(0, prev - 1));
                    }}
                    disabled={isSubmitting}
                    className="inline-flex items-center gap-2 rounded-2xl px-4 py-3 text-sm font-medium border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.03] text-slate-700 dark:text-zinc-200 hover:bg-slate-50 dark:hover:bg-white/[0.05] transition-colors disabled:opacity-50"
                  >
                    <ArrowLeft className="w-4 h-4" />
                    {step === 0 ? "Cancel" : "Back"}
                  </button>
                </div>

                <div className="flex items-center gap-2 justify-end">
                  {step < STEPS.length - 1 ? (
                    <button
                      type="button"
                      onClick={() => setStep((prev) => Math.min(STEPS.length - 1, prev + 1))}
                      disabled={nextDisabled || isSubmitting}
                      className={cn(
                        "inline-flex items-center gap-2 rounded-2xl px-5 py-3 text-sm font-medium transition-all",
                        nextDisabled || isSubmitting
                          ? "bg-slate-200 text-slate-500 cursor-not-allowed dark:bg-white/[0.08] dark:text-zinc-500"
                          : "bg-violet-600 text-white hover:bg-violet-700 shadow-sm shadow-violet-500/20"
                      )}
                    >
                      Next
                      <ArrowRight className="w-4 h-4" />
                    </button>
                  ) : (
                    <button
                      type="button"
                      onClick={handleSubmit}
                      disabled={!canSubmit || isSubmitting || isCompleted}
                      className={cn(
                        "inline-flex items-center gap-2 rounded-2xl px-5 py-3 text-sm font-medium transition-all",
                        !canSubmit || isSubmitting || isCompleted
                          ? "bg-slate-200 text-slate-500 cursor-not-allowed dark:bg-white/[0.08] dark:text-zinc-500"
                          : "bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm shadow-emerald-500/20"
                      )}
                    >
                      <CheckCircle2 className="w-4 h-4" />
                      {isSubmitting ? "Completing…" : "Complete Project"}
                    </button>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
