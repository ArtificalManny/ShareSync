function cn(...classes) {
  return classes.filter(Boolean).join(" ");
}

function safeNumber(value, fallback = 0) {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : fallback;
}

function uniqueStrings(list = []) {
  return [...new Set((Array.isArray(list) ? list : []).filter(Boolean))];
}

function formatLabel(value) {
  if (!value) return "";
  return String(value)
    .replace(/_/g, " ")
    .replace(/\b\w/g, (m) => m.toUpperCase());
}

function pluralize(count, singular, plural = `${singular}s`) {
  return `${count} ${count === 1 ? singular : plural}`;
}

function getStepState(currentStep, stepIndex) {
  if (stepIndex < currentStep) return "done";
  if (stepIndex === currentStep) return "active";
  return "upcoming";
}

function StepBadge({ index, label, currentStep }) {
  const state = getStepState(currentStep, index);

  const styles = {
    done: "bg-emerald-500 text-white border-emerald-500",
    active:
      "bg-violet-600 text-white border-violet-600 shadow-sm shadow-violet-500/25",
    upcoming:
      "bg-white text-slate-500 border-slate-200 dark:bg-white/[0.03] dark:text-zinc-400 dark:border-white/[0.08]",
  };

  return (
    <div className="flex items-center gap-2.5 min-w-0">
      <div
        className={cn(
          "w-8 h-8 rounded-full border flex items-center justify-center text-xs font-semibold flex-shrink-0 transition-all",
          styles[state]
        )}
      >
        {state === "done" ? <Check className="w-4 h-4" /> : index + 1}
      </div>
      <span
        className={cn(
          "text-xs font-medium truncate",
          state === "active"
            ? "text-slate-900 dark:text-zinc-100"
            : state === "done"
              ? "text-emerald-600 dark:text-emerald-300"
              : "text-slate-500 dark:text-zinc-400"
        )}
      >
        {label}
      </span>
    </div>
  );
}

