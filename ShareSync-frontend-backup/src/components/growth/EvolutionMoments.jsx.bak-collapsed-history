import React, { useState } from 'react';
import {
  ArrowRight,
  Sparkles,
  Trophy,
  ChevronDown,
  ChevronUp,
  Star,
  Target,
  Sprout,
  CheckCircle2,
  Hammer,
  Landmark,
  Crown,
  Rocket,
  Activity,
  BadgeCheck,
  TrendingUp,
  Users,
  ShieldCheck,
  ClipboardCheck,
  GitBranch,
} from 'lucide-react';

const ROLE_CONFIG = {
  Beginner: {
    color: 'text-slate-600 dark:text-zinc-400',
    bg: 'bg-slate-100 dark:bg-white/[0.05]',
    border: 'border-slate-200 dark:border-white/[0.08]',
    icon: Sprout,
  },
  Contributor: {
    color: 'text-teal-700 dark:text-teal-300',
    bg: 'bg-teal-50 dark:bg-teal-500/10',
    border: 'border-teal-200 dark:border-teal-500/20',
    icon: CheckCircle2,
  },
  Builder: {
    color: 'text-violet-700 dark:text-violet-300',
    bg: 'bg-violet-50 dark:bg-violet-500/10',
    border: 'border-violet-200 dark:border-violet-500/20',
    icon: Hammer,
  },
  Architect: {
    color: 'text-blue-700 dark:text-blue-300',
    bg: 'bg-blue-50 dark:bg-blue-500/10',
    border: 'border-blue-200 dark:border-blue-500/20',
    icon: Landmark,
  },
  Leader: {
    color: 'text-amber-700 dark:text-amber-300',
    bg: 'bg-amber-50 dark:bg-amber-500/10',
    border: 'border-amber-200 dark:border-amber-500/20',
    icon: Crown,
  },
  Visionary: {
    color: 'text-rose-700 dark:text-rose-300',
    bg: 'bg-rose-50 dark:bg-rose-500/10',
    border: 'border-rose-200 dark:border-rose-500/20',
    icon: Rocket,
  },
};

const MOMENT_TYPE_CONFIG = {
  task_completed: { label: 'Task Completed', icon: ClipboardCheck, color: 'text-teal-600 dark:text-teal-300', bg: 'bg-teal-50 dark:bg-teal-500/10', border: 'border-teal-200 dark:border-teal-500/20' },
  project_shipped: { label: 'Project Shipped', icon: Rocket, color: 'text-violet-600 dark:text-violet-300', bg: 'bg-violet-50 dark:bg-violet-500/10', border: 'border-violet-200 dark:border-violet-500/20' },
  streak_milestone: { label: 'Streak Milestone', icon: Activity, color: 'text-amber-600 dark:text-amber-300', bg: 'bg-amber-50 dark:bg-amber-500/10', border: 'border-amber-200 dark:border-amber-500/20' },
  quality_improved: { label: 'Quality Improved', icon: ShieldCheck, color: 'text-emerald-600 dark:text-emerald-300', bg: 'bg-emerald-50 dark:bg-emerald-500/10', border: 'border-emerald-200 dark:border-emerald-500/20' },
  collaboration_growth: { label: 'Collaboration Growth', icon: Users, color: 'text-cyan-600 dark:text-cyan-300', bg: 'bg-cyan-50 dark:bg-cyan-500/10', border: 'border-cyan-200 dark:border-cyan-500/20' },
  role_evolved: { label: 'Role Evolved', icon: GitBranch, color: 'text-violet-600 dark:text-violet-300', bg: 'bg-violet-50 dark:bg-violet-500/10', border: 'border-violet-200 dark:border-violet-500/20' },
  level_up: { label: 'Level Up', icon: TrendingUp, color: 'text-blue-600 dark:text-blue-300', bg: 'bg-blue-50 dark:bg-blue-500/10', border: 'border-blue-200 dark:border-blue-500/20' },
  default: { label: 'Growth Moment', icon: Activity, color: 'text-slate-600 dark:text-zinc-300', bg: 'bg-slate-100 dark:bg-white/[0.05]', border: 'border-slate-200 dark:border-white/[0.08]' },
};

function getRoleConfig(role) {
  return ROLE_CONFIG[role] || ROLE_CONFIG.Beginner;
}

function getMomentTypeConfig(moment) {
  const rawType =
    moment?.type ||
    moment?.eventType ||
    moment?.category ||
    moment?.kind ||
    'role_evolved';

  return MOMENT_TYPE_CONFIG[rawType] || MOMENT_TYPE_CONFIG.default;
}

function getMomentTitle(moment) {
  if (moment?.title) return moment.title;

  if (moment?.from && moment?.to) {
    return `${moment.from} to ${moment.to}`;
  }

  return 'Growth milestone';
}

function getMomentDescription(moment) {
  return (
    moment?.description ||
    moment?.explanation ||
    'This milestone reflects a meaningful change in your profile based on recent project activity.'
  );
}

function formatDate(dateStr) {
  if (!dateStr) return 'Recently';

  const date = new Date(dateStr);

  if (Number.isNaN(date.getTime())) return 'Recently';

  return date.toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
  });
}

function EvolutionCard({ moment, isLatest = false }) {
  const [isExpanded, setIsExpanded] = useState(isLatest);

  const fromConfig = getRoleConfig(moment?.from);
  const toConfig = getRoleConfig(moment?.to);
  const typeConfig = getMomentTypeConfig(moment);
  const RoleIcon = toConfig.icon;
  const TypeIcon = typeConfig.icon;

  const title = getMomentTitle(moment);
  const description = getMomentDescription(moment);

  return (
    <div
      className={`
        group overflow-hidden rounded-2xl border transition-all duration-200
        ${isLatest
          ? 'border-violet-200 bg-violet-50/40 shadow-[0_14px_40px_rgba(139,92,246,0.08)] dark:border-violet-500/25 dark:bg-violet-500/[0.06]'
          : 'border-slate-200/80 bg-white shadow-sm hover:border-slate-300 hover:shadow-[0_14px_40px_rgba(15,23,42,0.07)] dark:border-white/[0.07] dark:bg-[#1a1a1c] dark:hover:border-white/[0.12]'
        }
      `}
    >
      <button
        type="button"
        onClick={() => setIsExpanded((value) => !value)}
        className="w-full p-4 text-left transition-colors hover:bg-white/50 dark:hover:bg-white/[0.03]"
      >
        <div className="flex items-center gap-4">
          <div
            className={`
              relative flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border shadow-sm
              ${toConfig.bg} ${toConfig.border}
            `}
          >
            <RoleIcon className={`h-5 w-5 ${toConfig.color}`} />
            <span
              className={`
                absolute -bottom-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full border bg-white dark:bg-[#1a1a1c]
                ${typeConfig.border}
              `}
              title={typeConfig.label}
            >
              <TypeIcon className={`h-3 w-3 ${typeConfig.color}`} />
            </span>
          </div>

          <div className="min-w-0 flex-1">
            <div className="mb-1 flex flex-wrap items-center gap-2">
              {moment?.from && moment?.to ? (
                <>
                  <span className={`text-sm font-bold ${fromConfig.color}`}>
                    {moment.from}
                  </span>
                  <ArrowRight className="h-4 w-4 text-slate-400 dark:text-zinc-500" />
                  <span className={`text-sm font-black tracking-wide ${toConfig.color}`}>
                    {moment.to}
                  </span>
                </>
              ) : (
                <span className={`text-sm font-black tracking-wide ${toConfig.color}`}>
                  {title}
                </span>
              )}

              {isLatest && (
                <span className="rounded-full border border-violet-200 bg-white px-2 py-0.5 text-[10px] font-black uppercase tracking-[0.16em] text-violet-700 shadow-sm dark:border-violet-500/25 dark:bg-violet-500/10 dark:text-violet-300">
                  Current
                </span>
              )}
            </div>

            <div className="flex flex-wrap items-center gap-2">
              <span className="text-xs font-bold text-slate-500 dark:text-zinc-500">
                {formatDate(moment?.date || moment?.createdAt)}
              </span>
              <span className="h-1 w-1 rounded-full bg-slate-300 dark:bg-zinc-700" />
              <span className={`text-xs font-bold ${typeConfig.color}`}>
                {typeConfig.label}
              </span>
            </div>
          </div>

          {isExpanded ? (
            <ChevronUp className="h-5 w-5 shrink-0 text-slate-400 dark:text-zinc-500" />
          ) : (
            <ChevronDown className="h-5 w-5 shrink-0 text-slate-400 dark:text-zinc-500" />
          )}
        </div>
      </button>

      {isExpanded && (
        <div className="px-4 pb-4 animate-in slide-in-from-top-2 duration-200">
          <div className="rounded-2xl border border-slate-200/80 bg-white/75 p-4 shadow-inner dark:border-white/[0.08] dark:bg-white/[0.04]">
            <div className="flex items-start gap-3">
              <div
                className={`
                  mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border
                  ${typeConfig.bg} ${typeConfig.border}
                `}
              >
                <Sparkles className={`h-4 w-4 ${typeConfig.color}`} />
              </div>

              <div>
                <p className="text-sm font-semibold text-slate-800 dark:text-zinc-100">
                  {title}
                </p>
                <p className="mt-1 text-sm leading-6 text-slate-600 dark:text-zinc-400">
                  {description}
                </p>
              </div>
            </div>
          </div>

          {moment?.achievements?.length > 0 && (
            <div className="mt-4">
              <h5 className="mb-3 text-[11px] font-black uppercase tracking-[0.18em] text-slate-500 dark:text-zinc-400">
                Key Achievements
              </h5>

              <div className="space-y-2.5">
                {moment.achievements.map((achievement, index) => (
                  <div key={`${achievement}-${index}`} className="flex items-center gap-3 text-sm">
                    <div className="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-300">
                      <Trophy className="h-3.5 w-3.5" />
                    </div>
                    <span className="font-semibold text-slate-800 dark:text-zinc-200">
                      {achievement}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {moment?.metrics && (
            <div className="mt-4 grid grid-cols-3 gap-3">
              {Object.entries(moment.metrics).map(([key, value]) => (
                <div
                  key={key}
                  className="rounded-xl border border-slate-100 bg-slate-50 p-3 text-center shadow-sm dark:border-white/[0.05] dark:bg-white/[0.04]"
                >
                  <div className="mb-0.5 text-xl font-black text-slate-950 dark:text-white">
                    {value}
                  </div>
                  <div className="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-400">
                    {key.replace(/([A-Z])/g, ' $1').trim()}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  );
}

function EmptyEvolutionState() {
  return (
    <div className="rounded-2xl border border-dashed border-slate-300 bg-white/70 p-5 text-center dark:border-white/[0.14] dark:bg-white/[0.04]">
      <div className="mx-auto flex h-11 w-11 items-center justify-center rounded-2xl bg-violet-500/10 text-violet-600 dark:text-violet-300">
        <Activity className="h-5 w-5" />
      </div>
      <p className="mt-3 text-sm font-bold text-slate-900 dark:text-white">
        Evolution journey is warming up.
      </p>
      <p className="mx-auto mt-1 max-w-xs text-xs leading-5 text-slate-500 dark:text-zinc-400">
        Complete work, ship updates, and collaborate with teammates to generate growth milestones.
      </p>
    </div>
  );
}

export default function EvolutionMoments({
  moments = [],
  loading,
  className = '',
}) {
  if (loading) {
    return (
      <div className={`space-y-4 ${className}`}>
        {[1, 2].map((item) => (
          <div
            key={item}
            className="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm animate-pulse dark:border-white/[0.07] dark:bg-[#1a1a1c]"
          >
            <div className="flex items-center gap-4">
              <div className="h-12 w-12 rounded-2xl bg-slate-100 dark:bg-zinc-800" />
              <div className="flex-1">
                <div className="mb-2 h-4 w-32 rounded bg-slate-100 dark:bg-zinc-800" />
                <div className="h-3 w-20 rounded bg-slate-100 dark:bg-zinc-800" />
              </div>
            </div>
          </div>
        ))}
      </div>
    );
  }

  const safeMoments = Array.isArray(moments) ? moments : [];

  return (
    <div className={className}>
      <div className="mb-5 flex items-center gap-3">
        <div className="flex h-9 w-9 items-center justify-center rounded-2xl bg-amber-50 text-amber-600 ring-1 ring-amber-200/70 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-500/20">
          <GitBranch className="h-4.5 w-4.5" />
        </div>

        <div>
          <h3 className="text-lg font-black uppercase tracking-[0.12em] text-slate-900 dark:text-white">
            Evolution Journey
          </h3>
          <p className="mt-0.5 text-xs font-medium text-slate-500 dark:text-zinc-500">
            Role transitions and growth milestones over time
          </p>
        </div>
      </div>

      {safeMoments.length === 0 ? (
        <EmptyEvolutionState />
      ) : (
        <>
          <div className="space-y-4">
            {safeMoments.map((moment, index) => (
              <EvolutionCard
                key={moment?.id || moment?._id || `${moment?.from || 'moment'}-${moment?.to || index}`}
                moment={moment}
                isLatest={index === 0}
              />
            ))}
          </div>

          <div className="mt-5 rounded-2xl border border-dashed border-slate-300 bg-white/65 p-5 dark:border-white/[0.16] dark:bg-white/[0.035]">
            <div className="flex items-center gap-4">
              <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-slate-100 text-slate-600 ring-1 ring-slate-200 dark:bg-white/[0.06] dark:text-zinc-300 dark:ring-white/[0.08]">
                <Target className="h-5 w-5" />
              </div>

              <div>
                <p className="mb-0.5 text-sm font-black uppercase tracking-[0.12em] text-slate-800 dark:text-zinc-200">
                  Next Evolution
                </p>
                <p className="text-xs font-semibold leading-5 text-slate-500 dark:text-zinc-400">
                  Continue growing to unlock{' '}
                  <span className="text-slate-800 dark:text-zinc-200">
                    {safeMoments[0]?.to === 'Architect' ? 'Leader' : 'Architect'}
                  </span>{' '}
                  status.
                </p>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  );
}
