                bg-white dark:bg-surface-2
                border border-slate-200 dark:border-white/[0.10]
                text-slate-900 dark:text-text-secondary
                focus:outline-none focus:ring-2 focus:ring-violet-500/20 dark:focus:ring-brand-500/30
              "
