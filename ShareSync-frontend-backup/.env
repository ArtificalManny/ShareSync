# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5050
FRONTEND_URL=http://localhost:5173

# ============================================
# MONGODB
# ============================================
MONGO_URI=mongodb://localhost:27017/sharesync
# Some parts of the codebase might look for MONGODB_URI instead
MONGODB_URI=mongodb://localhost:27017/sharesync

# ============================================
# JWT SECRETS (CHANGE IN PRODUCTION)
# ============================================
# Access token secret (some files use JWT_SECRET, others might use JWT_ACCESS_SECRET)
JWT_SECRET=dev_secret_change_me_now
JWT_ACCESS_SECRET=dev_secret_change_me_now

# Refresh token secret
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_now

JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# EMAIL CONFIGURATION (optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShareSync <no-reply@sharesync.app>"

# ============================================
# TWILIO CONFIGURATION (optional)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# NOTE: VITE_* vars belong in the FRONTEND .env, not backend
# ============================================
